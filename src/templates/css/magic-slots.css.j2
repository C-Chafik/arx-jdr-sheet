/* ===== GENERATED from items.json — edit the .j2, not the output. =====
   The right page of the magic book: 20 fixed slots, one per known rune,
   filled reading-order (top-left, across, then down a row) as the player
   consumes runes. Icons render at their native magicbook-artwork size minus
   a quarter (~120×178px average source → 5.76% × 13.27% of the 1563×1006
   book/magicbook.png container, ×0.75). 5 columns × 4 rows, pitch spread to
   fill the right page's width/height. Origin/pitch are a first pass over
   the right page's blank parchment — expect a visual tuning pass. */

{% set sb_cols = 5 %}
{% set sb_ox, sb_oy = 53.0, 8.0 %}
{% set sb_px, sb_py = 7.3, 20.5 %}
{% set sb_w, sb_h = 5.76, 13.27 %}
{% for i in range(20) %}
.sheet-spellbook-slot--{{ i + 1 }} {
  left: {{ "%.2f" | format(sb_ox + (i % sb_cols) * sb_px) }}%;
  top: {{ "%.2f" | format(sb_oy + (i // sb_cols) * sb_py) }}%;
}
{% endfor %}

.sheet-spellbook-slot {
  position: absolute;
  width: {{ sb_w }}%;
  height: {{ sb_h }}%;
  padding: 0;
  border: none;
  background: transparent;
  cursor: url('{{ "{{ASSET_BASE}}" }}/ui/cursor-hover.png') 8 4, pointer;
}

/* Immediate hover feedback on a learned rune — no click needed. */
.sheet-spellbook-slot:hover .sheet-item-icon {
  filter: brightness(1.8) drop-shadow(0 0 10px rgba(255, 220, 130, 1));
}

/* Fill the slot box exactly (no 80%/10% inset) — the box IS the target icon size. */
.sheet-spellbook-slot .sheet-item-icon {
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* Reuses .sheet-item-icon's base display:none (defined in inventory-slots.css.j2);
   only the reveal + magicbook artwork are scoped to this page, so a rune's
   OWN icon rule (used in the bag) never leaks in here. */
{% for item_id, item in items.items() %}
{% if item.effect | default("") == "rune" %}
.sheet-spellbook-slot input[value="{{ item_id }}"] + .sheet-item-icon {
  display: block;
  background-image: url('{{ "{{ASSET_BASE}}" }}/{{ item.icon | replace("runes/", "runes/magicbook-") }}');
}
{% endif %}
{% endfor %}

/* Rune-craft: a slot's icon glows while its rune is part of the in-progress
   combination (attr_craft_runes, delimited "|rune-x|rune-y|" — see
   inventory.js's craftJoin). */
{% for item_id, item in items.items() %}
{% if item.effect | default("") == "rune" %}
.sheet-arx:has(input[name="attr_craft_runes"][value*="|{{ item_id }}|"]) .sheet-spellbook-slot input[value="{{ item_id }}"] + .sheet-item-icon {
  filter: brightness(1.8) drop-shadow(0 0 10px rgba(255, 220, 130, 1));
}
{% endif %}
{% endfor %}

/* Rune/spell name on hover — yellow with a star, distinct from the regular
   white item billboard (and shown only while hovering the SPELLBOOK slot or
   the cast 2x2 slot, not the rune in the bag). */
.sheet-spell-statbar {
  color: #ffd700;
  text-shadow: 0 0 3px rgba(0, 0, 0, 0.9), 0 1px 2px rgba(0, 0, 0, 0.9);
}
{% for item_id, item in items.items() %}
{% if item.effect | default("") == "rune" %}
.sheet-arx:has(.sheet-spellbook-slot:hover input[value="{{ item_id }}"]) .sheet-statbar--spell-{{ item_id }} {
  display: block;
}
{% endif %}
{% endfor %}
{% for spell_id, spell in spells.items() %}
.sheet-arx:has(.sheet-spell-slot--{{ spell_id }}:hover) .sheet-statbar--cast-{{ spell_id }} {
  display: block;
}
{% endfor %}

/* The grimoire: a modest drop-target on the LEFT page (the right page is now
   filled almost edge-to-edge by the 20-slot grid). Placed below the knotwork
   art, clear of the numbered page tabs on the left edge. */
.sheet-grimoire {
  position: absolute;
  left: 15%;
  top: 88%;
  width: 30%;
  height: 7%;
  padding: 0;
  border: none;
  background: transparent;
  cursor: url('{{ "{{ASSET_BASE}}" }}/ui/cursor-hover.png') 6 4, pointer;
  border-radius: 8px;
  transition: background 0.35s ease-out, box-shadow 0.35s ease-out;
}

/* Glows when holding any rune. */
input[name="attr_hand_effect"][value="rune"] ~ .sheet-book .sheet-grimoire {
  background: radial-gradient(circle, rgba(255, 232, 160, 0.4), rgba(255, 232, 160, 0) 75%);
  box-shadow: 0 0 14px rgba(255, 220, 130, 0.8);
}

/* Rune-craft controls: icon buttons, bottom-right of the LEFT page — clear
   of the grimoire/presets above and of the inventory band/toggle that sits
   just below the book (see inventory.css: .sheet-inventory-toggle,
   .sheet-inventory). */
.sheet-craft-confirm, .sheet-craft-memorize, .sheet-craft-reset {
  position: absolute;
  top: 82%;
  width: 5%;
  height: 5%;
  z-index: 5; /* sits over preset-slot--3, whose box overlaps this corner */
  padding: 0;
  border: none;
  background-color: transparent;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  cursor: url('{{ "{{ASSET_BASE}}" }}/ui/cursor-hover.png') 6 4, pointer;
  transition: filter 0.2s ease-out;
}
.sheet-craft-confirm:hover, .sheet-craft-memorize:hover, .sheet-craft-reset:hover {
  filter: brightness(1.8) drop-shadow(0 0 10px rgba(255, 220, 130, 1));
}
.sheet-craft-reset { left: 35%; background-image: url('{{ "{{ASSET_BASE}}" }}/ui/delete-logo.png'); }
.sheet-craft-confirm { left: 40%; background-image: url('{{ "{{ASSET_BASE}}" }}/ui/cast-spell.png'); }
.sheet-craft-memorize { left: 45%; background-image: url('{{ "{{ASSET_BASE}}" }}/ui/save-preset-button.png'); }

.sheet-arx:has(.sheet-craft-confirm:hover) .sheet-statbar--craft-confirm { display: block; }
.sheet-arx:has(.sheet-craft-memorize:hover) .sheet-statbar--craft-memorize { display: block; }
.sheet-arx:has(.sheet-craft-reset:hover) .sheet-statbar--craft-reset { display: block; }

/* Forget-a-preset mode (Reset clicked with no rune in the combo): the
   preset slots swap to a delete cursor until one is picked (or Reset is
   clicked again to cancel) — see inventory.js's clicked:preset_N. */
.sheet-arx:has(input[name="attr_forget_mode"][value="1"]) .sheet-preset-slot {
  cursor: url('{{ "{{ASSET_BASE}}" }}/ui/delete-logo.png') 16 16, crosshair;
}

/* Craft sequence: sits in the 160px strip reserved to the right of the book
   (see base.css's .sheet-arx/.sheet-book), near its top edge — outside the
   book art but still close to it, not floating off in blank space.
   Negative right escapes .sheet-book's own box (its nearest positioned
   ancestor) the same way .sheet-inventory already tucks under it with a
   negative margin. attr_craft_pos_1 (slot 1, flush against the sheet's
   right edge) always holds the MOST RECENTLY clicked rune — each new click
   bumps every earlier one outward/left by one slot (see inventory.js's
   craftPositions, indexed from the end of the list, not the start).
   Packed tight ("côte à côte") — reuses .sheet-item-icon's own display:none
   default; the reveal below scopes to THIS class only, using each rune's
   actual inventory icon (item.icon), not the magicbook variant used in the
   spellbook grid — plus a permanent glow, since these are always "selected". */
.sheet-craft-seq {
  position: absolute;
  top: 0px;
  width: 48px;  /* native size of a rune's inventory icon (item-rune-*.png) */
  height: 48px;
}
.sheet-craft-seq--1 { right: -160px; }
.sheet-craft-seq--2 { right: -124px; }
.sheet-craft-seq--3 { right: -88px; }
.sheet-craft-seq--4 { right: -52px; }
.sheet-craft-seq--5 { right: -16px; }
{% for item_id, item in items.items() %}
{% if item.effect | default("") == "rune" %}
.sheet-craft-seq input[value="{{ item_id }}"] + .sheet-item-icon {
  display: block;
  background-image: url('{{ "{{ASSET_BASE}}" }}/{{ item.icon }}');
}
{% endif %}
{% endfor %}

/* Pulsing glow — a static filter looked flat, so this animates it instead. */
@keyframes craft-seq-glow {
  0%, 100% { filter: brightness(1.2) drop-shadow(0 0 4px rgba(255, 220, 130, 0.8)); }
  50% { filter: brightness(1.8) drop-shadow(0 0 14px rgba(255, 220, 130, 1)); }
}
.sheet-craft-seq .sheet-item-icon {
  animation: craft-seq-glow 1.6s ease-in-out infinite;
}

/* ---- Spell recipe view: clicking a spell in the 2×2 slots highlights every
   rune it requires in the 20-slot grid, each tagged with its position number
   in the recipe (attr_recipe_spell holds the clicked spell's id — see
   inventory.js; a second click of the same spell clears it). ---- */
.sheet-recipe-order {
  display: none;
  position: absolute;
  right: -10%;
  bottom: -10%;
  width: 55%;
  height: 55%;
  border-radius: 50%;
  background: #2b1d0e;
  border: 1px solid #ffd700;
  color: #ffd700;
  font-size: 28px;
  font-weight: bold;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  z-index: 2;
}
{% for spell_id, spell in spells.items() %}
{% for rune in spell.runes %}
.sheet-arx:has(input[name="attr_recipe_spell"][value="{{ spell_id }}"]) .sheet-spellbook-slot input[value="{{ rune }}"] + .sheet-item-icon {
  filter: brightness(1.9) drop-shadow(0 0 12px rgba(255, 220, 130, 1));
}
.sheet-arx:has(input[name="attr_recipe_spell"][value="{{ spell_id }}"]) .sheet-spellbook-slot input[value="{{ rune }}"] ~ .sheet-recipe-order {
  display: flex;
}
.sheet-arx:has(input[name="attr_recipe_spell"][value="{{ spell_id }}"]) .sheet-spellbook-slot input[value="{{ rune }}"] ~ .sheet-recipe-order::before {
  content: "{{ loop.index }}";
}
{% endfor %}
{% endfor %}

/* ---- Spell-page navigation: book/magicbook.png no longer bakes the numbered
   tabs into the artwork, so magic-nav-N.png IS the tab now (always drawn,
   not just on hover). A tab opens as soon as the character has consumed
   every rune of AT LEAST ONE spell assigned to that page — not merely
   because spells.json happens to define a spell there. Page 1 is always
   shown (it's the entry point) even before any rune is known. ---- */
.sheet-spell-page-tab {
  display: none;
  position: absolute;
  left: 1.6%;
  width: 7.2%;
  height: 5.5%;
  padding: 0;
  border: none;
  background-color: transparent;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  cursor: url('{{ "{{ASSET_BASE}}" }}/ui/cursor-hover.png') 6 4, pointer;
  transition: filter 0.2s ease-out, box-shadow 0.2s ease-out;
}
.sheet-spell-page-tab:hover {
  filter: brightness(1.3);
  box-shadow: 0 0 10px rgba(255, 220, 130, 0.85);
}
.sheet-spell-page-tab--1 { display: block; } /* always visible, even with no rune known yet */
{% for p in range(1, 11) %}
.sheet-spell-page-tab--{{ p }} { background-image: url('{{ "{{ASSET_BASE}}" }}/book/magicbook-nav-{{ p }}.png'); }
{% set spells_here = spells.values() | selectattr("page", "equalto", p) | list %}
{% if spells_here %}
{% for spell in spells_here %}.sheet-arx{% for rune in spell.runes %}:has(input[name="attr_known_{{ rune[5:] }}"][value="1"]){% endfor %} .sheet-spell-page-tab--{{ p }}{% if not loop.last %},
{% endif %}{% endfor %} {
  display: block;
}
{% endif %}
{% endfor %}
.sheet-spell-page-tab--1  { top: 12.5%; }
.sheet-spell-page-tab--2  { top: 19.0%; }
.sheet-spell-page-tab--3  { top: 27.5%; }
.sheet-spell-page-tab--4  { top: 34.0%; }
.sheet-spell-page-tab--5  { top: 45.0%; }
.sheet-spell-page-tab--6  { top: 53.0%; }
.sheet-spell-page-tab--7  { top: 59.5%; }
.sheet-spell-page-tab--8  { top: 65.0%; }
.sheet-spell-page-tab--9  { top: 72.0%; }
.sheet-spell-page-tab--10 { top: 85.0%; }

/* ---- The 4 fixed spell-slot positions on the left page: a 2×2 grid
   (1=top-left, 2=top-right, 3=bottom-left, 4=bottom-right) centered on the
   page's middle, with generous blank margin above and below. First pass —
   expect a tuning pass once real spell art exists. ---- */
.sheet-spell-slot {
  display: none;
  position: absolute;
  width: 17%;
  height: 25%;
  padding: 0;
  border: none;
  background: transparent;
  color: #2b1d0e;
  font-size: 12px;
  text-align: center;
  cursor: url('{{ "{{ASSET_BASE}}" }}/ui/cursor-hover.png') 6 4, pointer;
}
.sheet-spell-slot:hover .sheet-spell-icon {
  filter: brightness(1.35) drop-shadow(0 0 6px rgba(255, 220, 130, 0.9));
}
.sheet-spell-slot:active .sheet-spell-icon {
  /* Instant flash on press, brighter than the hover glow. */
  filter: brightness(1.7) drop-shadow(0 0 12px rgba(255, 220, 130, 1));
  transition: none;
}
.sheet-spell-slot--slot-1 { left: 8%;  top: 14%; }
.sheet-spell-slot--slot-2 { left: 30%; top: 14%; }
.sheet-spell-slot--slot-3 { left: 8%;  top: 45%; }
.sheet-spell-slot--slot-4 { left: 30%; top: 45%; }

.sheet-spell-icon {
  display: block;
  width: 82%;
  height: 82%;
  margin: 9% auto 0;
  background-size: contain; /* the spell's own image, at its own proportions */
  background-repeat: no-repeat;
  background-position: center;
  transition: filter 0.2s ease-out;
}
{% for spell_id, spell in spells.items() %}
{% if spell.icon %}
.sheet-spell-slot--{{ spell_id }} .sheet-spell-icon {
  background-image: url('{{ "{{ASSET_BASE}}" }}/{{ spell.icon }}');
}
{% endif %}
{% endfor %}

/* A spell shows only on its assigned page, once every rune it requires is
   known — one :has() per condition composes as AND regardless of where in
   the tree each piece (hidden page mirror, known-flag mirror) actually
   lives. attr_spell_page is a plain hidden input set by the worker on
   button click (see tabs.html.j2/magic.html.j2 + inventory.js), not a
   radio's :checked state. */
{% for spell_id, spell in spells.items() %}
.sheet-arx:has(input[name="attr_spell_page"][value="{{ spell.page }}"]){% for rune in spell.runes %}:has(input[name="attr_known_{{ rune[5:] }}"][value="1"]){% endfor %} .sheet-spell-slot--{{ spell_id }} {
  display: block;
}
{% endfor %}

/* ---- Preset (memorized) spells: 3 fixed slots in the lower-left area of the
   left page, empty of any other content. Each can hold ANY preset-eligible
   spell (book spell or secret one — see presets.json); which one is just
   whatever attr_preset_slot_N currently holds. Obtaining a preset (a spell
   scroll item, or an action sequence) isn't wired yet — first pass on
   position/visuals only, expect a tuning pass. The source art is flat white
   line work; recolored to solid blue (to match the reference screenshot) via
   a filter chain — brightness(0) flattens it to black regardless of source
   tone, the rest recolors that black into #2566e0 (mask-image left it
   invisible, likely unsupported here, so this reuses the same
   background-image technique as every other icon on the sheet). ---- */
{% set preset_blue = "brightness(0) invert(47%) sepia(100%) saturate(600%) hue-rotate(183deg)" %}
.sheet-preset-slot {
  position: absolute;
  width: 9%;
  height: 9%;
  padding: 0;
  border: none;
  background: transparent;
  cursor: url('{{ "{{ASSET_BASE}}" }}/ui/cursor-hover.png') 6 4, pointer;
}
.sheet-preset-slot--1 { left: 19%; top: 76%; }
.sheet-preset-slot--2 { left: 25%; top: 76%; }
.sheet-preset-slot--3 { left: 31%; top: 76%; }

.sheet-preset-icon {
  display: none;
  position: absolute;
  left: 0;
  top: 0;
  width: 50%;
  height: 50%;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  filter: {{ preset_blue }};
  transition: filter 0.2s ease-out;
}
.sheet-preset-slot:hover .sheet-preset-icon {
  filter: {{ preset_blue }} brightness(1.3) drop-shadow(0 0 6px rgba(80, 170, 255, 0.9));
}
.sheet-preset-slot:active .sheet-preset-icon {
  filter: {{ preset_blue }} brightness(1.5) drop-shadow(0 0 12px rgba(80, 170, 255, 1));
  transition: none;
}
{% for preset_id, preset in presets.items() %}
.sheet-preset-slot input[value="{{ preset_id }}"] + .sheet-preset-icon {
  display: block;
  background-image: url('{{ "{{ASSET_BASE}}" }}/{{ preset.icon }}');
}
{% endfor %}

/* Preset name on hover — same yellow as the book's spells; secret ones
   (no book entry) read red instead, both keeping the ★ prefix. */
.sheet-preset-statbar {
  color: #ffd700;
  text-shadow: 0 0 3px rgba(0, 0, 0, 0.9), 0 1px 2px rgba(0, 0, 0, 0.9);
}
.sheet-preset-statbar--secret {
  color: #ff2b2b;
}
{% for preset_id, preset in presets.items() %}
.sheet-arx:has(.sheet-preset-slot:hover input[value="{{ preset_id }}"]) .sheet-statbar--preset-{{ preset_id }} {
  display: block;
}
{% endfor %}
