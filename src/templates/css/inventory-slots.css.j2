/* ===== GENERATED from items.json + grid constants — edit the .j2, not the output. ===== */

/* ---- Bag grid constants (cols × rows × bags injected by build.py) on
   ui/inventory-band.png (2042 × 390), % of .sheet-inventory. ---- */
{% set per_level = cols * rows %}
{% set total = per_level * bags %}
{% set ox, oy = 2.7, 11.5 %}   {# origin of slot (1,1), in % — seams measured at x55/y45 #}
{% set px_, py_ = 5.91, 26.9 %} {# pitch between slots, in % — 120.7 × 105 px on the 2042×390 band #}
{% set sw, sh = 5.3, 24.4 %}   {# slot size, in % #}

/* Item icons: hidden by default, shown when the slot input holds a known item id. */
.sheet-item-icon {
  display: none;
  position: absolute;
  left: 10%;
  top: 10%;
  width: 80%;
  height: 80%;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  pointer-events: none;
}
{% for item_id, item in items.items() %}
.sheet-slot input[value="{{ item_id }}"] + .sheet-item-icon {
  display: block;
  background-image: url('{{ "{{ASSET_BASE}}" }}/{{ item.icon }}');
{% if item.legendary | default(false) %}
  /* Legendary: permanent golden halo around the icon's own silhouette. */
  filter: drop-shadow(0 0 3px #ffd700) drop-shadow(0 0 6px #ffae00);
{% endif %}
}
{% endfor %}

/* In the bag, an icon spans its item's footprint (anchored top-left).
   Spans are relative to the anchor cell box; equipment slots keep the default fit. */
{% for item_id, item in items.items() %}
{% set w = (item.size | default("1x1")).split("x")[0] | int %}
{% set h = (item.size | default("1x1")).split("x")[1] | int %}
{% if w > 1 or h > 1 %}
.sheet-inventory .sheet-slot input[value="{{ item_id }}"] + .sheet-item-icon {
  width: {{ "%.1f" | format(((w - 1) * px_ / sw + 0.8) * 100) }}%;
  height: {{ "%.1f" | format(((h - 1) * py_ / sh + 0.8) * 100) }}%;
}
{% endif %}
{% endfor %}

/* In an equipment slot an icon must never be drawn BIGGER than the bag draws
   it. The equip frames are a fixed ~72 × 64 px and the icon always filled 80%
   of that, whatever the item — so a small footprint came out zoomed the moment
   it was equipped (a 1x1 helmet: 33.6 px in the bag, 51.4 px in the slot, ×1.5;
   a jewel ×1.7), while a 2x3 chestplate shrank from 91 px to 51 px.
   min() takes the bag's own pixel size, or 80% of the frame when the item is
   too big to fit — so nothing overflows the artwork either. Centered rather
   than inset 10%, since the box no longer fills its frame.
   Bag geometry: the band is 900 × 172 px, hence a cell of sw × sh % and a
   pitch of px_ × py_ % converted to px below — the very numbers the bag spans
   above are built from. */
{% set equip_cats = ["casque", "armure_haute", "armure_basse", "bijoux",
                     "main_principale", "main_secondaire", "ambidextrie", "deux_mains"] %}
{% for item_id, item in items.items() if item.cat in equip_cats %}
{% set w = (item.size | default("1x1")).split("x")[0] | int %}
{% set h = (item.size | default("1x1")).split("x")[1] | int %}
.sheet-book .sheet-slot input[value="{{ item_id }}"] + .sheet-item-icon {
  left: 50%;
  top: 50%;
  width: min(80%, {{ "%.1f" | format(((w - 1) * px_ + 0.8 * sw) / 100 * 900) }}px);
  height: min(80%, {{ "%.1f" | format(((h - 1) * py_ + 0.8 * sh) / 100 * 172) }}px);
  transform: translate(-50%, -50%);
}
{% endfor %}

/* In the bag, the ANCHOR's button stretches over the whole footprint (above the
   covered cells' buttons), so hovering/clicking anywhere on the item acts on it. */
{% for item_id, item in items.items() %}
{% set w = (item.size | default("1x1")).split("x")[0] | int %}
{% set h = (item.size | default("1x1")).split("x")[1] | int %}
{% if w > 1 or h > 1 %}
.sheet-inventory .sheet-slot input[value="{{ item_id }}"] ~ button {
  width: {{ "%.1f" | format(((w - 1) * px_ / sw + 1) * 100) }}%;
  height: {{ "%.1f" | format(((h - 1) * py_ / sh + 1) * 100) }}%;
  z-index: 3;
}
{% endif %}
{% endfor %}

/* Item name on hover — reveals the matching billboard generated in sheet.html.j2. */
{% for item_id in items %}
.sheet-arx:has(.sheet-slot:hover input[value="{{ item_id }}"]) .sheet-statbar--item-{{ item_id }} { display: block; }
{% endfor %}

/* The equipment spec line appended to an item's hover name (see the
   item_specs macro in sheet.html.j2) — dimmer and smaller than the label, so
   the name still reads first. Shared with the stat billboards' own breakdown
   (base | bonus | équipement, see base.html.j2): same question about a
   different object, so deliberately the same treatment rather than a
   look-alike that would drift. */
.sheet-item-specs,
.sheet-stat-breakdown {
  margin-left: 0.4em;
  color: #d8a24a;
  font-size: 0.8em;
}

/* Legendary items: their hover name reads in red instead of the default white. */
{% for item_id, item in items.items() %}
{% if item.legendary | default(false) %}
.sheet-statbar--item-{{ item_id }} { color: #ff2b2b; }
{% endif %}
{% endfor %}

/* ---- Slot shell: invisible zone with an action button covering it. ---- */
.sheet-slot {
  position: absolute;
}
.sheet-slot button[type="action"] {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  padding: 0;
  border: none;
  background: transparent;
  cursor: url('{{ "{{ASSET_BASE}}" }}/ui/cursor-hover.png') 6 4, pointer;
}

/* ---- Bag levels: only the level matching attr_bag_level is shown. ---- */
.sheet-inventory .sheet-slot {
  display: none;
}
{% for lvl in range(1, bags + 1) %}
input[name="attr_bag_level"][value="{{ lvl }}"] ~ .sheet-inventory .sheet-bag-level-{{ lvl }} {
  display: block;
}
{% endfor %}

/* ---- Bag cell positions (shared by every level). ---- */
{% for i in range(per_level) %}
.sheet-bag-cell-{{ i }} { left: {{ "%.2f" | format(ox + (i % cols) * px_) }}%; top: {{ "%.2f" | format(oy + (i // cols) * py_) }}%; width: {{ sw }}%; height: {{ sh }}%; }
{% endfor %}

/* ---- The pouch (rightmost band column) + level navigation arrows. ---- */
.sheet-pouch {
  position: absolute;
  left: 94.3%;
  top: 9%;
  width: 5.4%;
  height: 84%;
  padding: 0;
  border: none;
  background: transparent;
  cursor: url('{{ "{{ASSET_BASE}}" }}/ui/cursor-hover.png') 6 4, pointer;
  border-radius: 8px;
  transition: background 0.35s ease-out, box-shadow 0.35s ease-out;
}
.sheet-bag-nav {
  display: none;
  position: absolute;
  left: 93.5%;
  width: 3.6%;
  height: 20%;
  padding: 0;
  border: none;
  z-index: 4;
  background-color: transparent;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  cursor: url('{{ "{{ASSET_BASE}}" }}/ui/cursor-hover.png') 6 4, pointer;
  transition: filter 0.2s ease-out;
}
.sheet-bag-nav:hover { filter: brightness(1.35) drop-shadow(0 0 5px rgba(255, 220, 130, 0.8)); }
.sheet-bag-nav--up   { top: 24%; background-image: url('{{ "{{ASSET_BASE}}" }}/ui/inventory-up-button.png'); }
.sheet-bag-nav--down { top: 72%; background-image: url('{{ "{{ASSET_BASE}}" }}/ui/inventory-down-button.png'); }

/* Up is visible whenever we're below the surface level. */
{% for lvl in range(2, bags + 1) %}
input[name="attr_bag_level"][value="{{ lvl }}"] ~ .sheet-inventory .sheet-bag-nav--up { display: block; }
{% endfor %}
/* Down is visible while a deeper unlocked level exists (count > level). */
{% for count in range(2, bags + 1) %}
{% for lvl in range(1, count) %}
input[name="attr_bag_count"][value="{{ count }}"] ~ input[name="attr_bag_level"][value="{{ lvl }}"] ~ .sheet-inventory .sheet-bag-nav--down { display: block; }
{% endfor %}
{% endfor %}

/* The pouch glows when holding an extra_bag item and a level can still be unlocked. */
{% for item_id, item in items.items() %}
{% if item.effect | default("") == "extra_bag" %}
input[name="attr_hand"][value="{{ item_id }}"] ~ input[name="attr_bag_count"]:not([value="{{ bags }}"]) ~ .sheet-inventory .sheet-pouch {
  background: radial-gradient(circle, rgba(255, 232, 160, 0.4), rgba(255, 232, 160, 0) 75%);
  box-shadow: 0 0 14px rgba(255, 220, 130, 0.8);
}
{% endif %}
{% endfor %}

/* ---- Trash: deletes the held item. Hidden unless something is in hand. ---- */
.sheet-trash {
  display: none;
  position: absolute;
  left: 95.2%;
  top: 8%;
  width: 3.6%;
  height: 13%;
  padding: 0;
  border: none;
  z-index: 4;
  background: transparent;
  color: #e53030;
  font-size: 1.6em;
  line-height: 1;
  cursor: url('{{ "{{ASSET_BASE}}" }}/ui/cursor-hover.png') 6 4, pointer;
  transition: filter 0.2s ease-out;
}
.sheet-trash::before { content: "✕"; }
.sheet-trash:hover { filter: brightness(1.4) drop-shadow(0 0 4px rgba(229, 48, 48, 0.9)); }
input[name="attr_hand"]:not([value=""]) ~ .sheet-inventory .sheet-trash { display: block; }

/* ---- Read scroll: reads + consumes the held scroll. Hidden unless a
   "scroll" item is in hand (see items.json's scroll-* entries and
   clicked:read_scroll in inventory.js). First-pass position, next to the
   trash. ---- */
.sheet-read-scroll {
  display: none;
  position: absolute;
  left: 88.5%;
  top: 8%;
  width: 5.4%;
  height: 13%;
  padding: 0;
  border: none;
  z-index: 4;
  background-color: transparent;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  background-image: url('{{ "{{ASSET_BASE}}" }}/ui/cast-spell.png');
  cursor: url('{{ "{{ASSET_BASE}}" }}/ui/cursor-hover.png') 6 4, pointer;
  transition: filter 0.2s ease-out;
}
.sheet-read-scroll:hover { filter: brightness(1.4) drop-shadow(0 0 4px rgba(255, 220, 130, 0.9)); }
input[name="attr_hand_effect"][value="scroll"] ~ .sheet-inventory .sheet-read-scroll { display: block; }
.sheet-arx:has(.sheet-read-scroll:hover) .sheet-statbar--read-scroll { display: block; }

/* ---- Consommer: same slot in the band as the Lire button above, widened
   leftward for its label. An item carries a single "effect", so a scroll can
   never also be food and the two buttons can never both be up. Only shown
   while a consumable is in hand, exactly like Lire and the trash. ---- */
.sheet-consume {
  display: none;
  position: absolute;
  left: 84.6%;
  top: 8%;
  width: 9.3%;
  height: 13%;
  z-index: 4;
}
.sheet-consume-face {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(43, 29, 14, 0.8);
  border-radius: 3px;
  background: linear-gradient(rgba(60, 42, 18, 0.85), rgba(30, 20, 8, 0.9));
  color: #f0e2bc;
  font-family: inherit;
  font-size: 11px;
  text-shadow: 0 0 3px rgba(0, 0, 0, 0.95);
  pointer-events: none;
  transition: filter 0.2s ease-out;
}
.sheet-consume:hover .sheet-consume-face {
  filter: brightness(1.4) drop-shadow(0 0 5px rgba(255, 220, 130, 0.9));
}
.sheet-consume button {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  padding: 0;
  border: none;
  background: transparent;
  cursor: url('{{ "{{ASSET_BASE}}" }}/ui/cursor-hover.png') 6 4, pointer;
}
{% for effect in ["food", "drinks", "potions"] %}
input[name="attr_hand_effect"][value="{{ effect }}"] ~ .sheet-inventory .sheet-consume { display: block; }
{% endfor %}

/* ---- Equipment slots on book/base.png (1598 × 984), % of .sheet-book. ---- */
.sheet-slot--equip_main_hand { left: 17.2%; top: 11.0%; width: 6.9%; height: 9.9%; }
.sheet-slot--equip_off_hand  { left: 38.8%; top: 11.0%; width: 6.6%; height: 9.3%; }
/* Armor slots (head/torso/belt) are engraved much smaller than the weapon and
   jewel frames on book/base.png. Rather than re-export that image, an
   ui/armory-slot.png frame is overlaid behind each, enlarged to match — the
   equipped icon (which sizes off its .sheet-slot box) grows along with it. */
.sheet-slot--equip_head,
.sheet-slot--equip_torso,
.sheet-slot--equip_belt {
  background-image: url('{{ "{{ASSET_BASE}}" }}/ui/armory-slot.png');
  background-size: 100% 100%;
  width: 6.6%;
  height: 9.5%;
}
.sheet-slot--equip_head  { left: 28.85%; top: 18.75%; }
.sheet-slot--equip_torso { left: 28.6%;  top: 31.65%; }
.sheet-slot--equip_belt  { left: 28.7%;  top: 58.15%; }
.sheet-slot--equip_jewel_1   { left: 13.5%; top: 77.7%; width: 6.6%; height: 10.7%; }
.sheet-slot--equip_jewel_2   { left: 41.7%; top: 77.7%; width: 6.6%; height: 10.7%; }

/* ---- Attack roll, one button per hand, centered just under its own slot
   (both slots end around 20.5%). A gloved hand facing the way that hand
   does — hence two assets rather than one mirrored in CSS. Always visible,
   whether or not the hand holds anything: an empty hand rolls bare fists
   (see rollHandDamage in inventory.js). Sized in px, not %, so the 32×32
   source draws 1:1 and stays crisp — the only px box among the slots, which
   are all cut from the book artwork and must scale with it. ---- */
.sheet-attack-btn {
  position: absolute;
  top: 22%;
  width: 32px;
  height: 32px;
  padding: 0;
  border: none;
  background-color: transparent;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  cursor: url('{{ "{{ASSET_BASE}}" }}/ui/cursor-hover.png') 6 4, pointer;
  transition: filter 0.2s ease-out;
}
.sheet-attack-btn:hover { filter: brightness(1.35) drop-shadow(0 0 6px rgba(255, 220, 130, 0.8)); }
{# Centered under each slot: the slot's own center, minus half the button's
   32px. .sheet-book is 1100px wide (base.css), so 16px is 1.45% of it. #}
.sheet-attack-btn--equip_main_hand {
  left: 19.2%; /* .sheet-slot--equip_main_hand center 20.65% (17.2 + 6.9/2) − 1.45% */
  background-image: url('{{ "{{ASSET_BASE}}" }}/ui/attack_left.png');
}
.sheet-attack-btn--equip_off_hand {
  left: 40.65%; /* .sheet-slot--equip_off_hand center 42.1% (38.8 + 6.6/2) − 1.45% */
  background-image: url('{{ "{{ASSET_BASE}}" }}/ui/attack_right.png');
}
{% for slot in ["equip_main_hand", "equip_off_hand"] %}
.sheet-arx:has(.sheet-attack-btn--{{ slot }}:hover) .sheet-statbar--attack-{{ slot }} { display: block; }
{% endfor %}

/* Equipment slot tooltips — same top-banner billboard as everything else.
   Only while the slot is EMPTY: once something is equipped, its own item
   name tooltip (see .sheet-statbar--item-* above) takes over instead, so
   the two never show stacked together. */
{% for slot in ["equip_head", "equip_torso", "equip_belt", "equip_main_hand",
                "equip_off_hand", "equip_jewel_1", "equip_jewel_2"] %}
.sheet-arx:has(.sheet-slot--{{ slot }}:hover input[value=""]) .sheet-statbar--{{ slot }} { display: block; }
{% endfor %}

/* Faint background hint of what belongs in each slot — reuses existing item
   art at low opacity (no new assets needed); hidden once something is
   actually equipped (the item's own icon takes over via its own reveal
   rule). Jewel slots get a plain CSS star instead (no dedicated asset). */
.sheet-slot-hint {
  display: block;
  position: absolute;
  left: 15%;
  top: 15%;
  width: 70%;
  height: 70%;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  opacity: 0.4;
  filter: grayscale(1);
  pointer-events: none;
}
.sheet-slot input:not([value=""]) ~ .sheet-slot-hint { display: none; }
.sheet-slot--equip_head .sheet-slot-hint      { background-image: url('{{ "{{ASSET_BASE}}" }}/items/plate-helmet.png'); }
.sheet-slot--equip_off_hand .sheet-slot-hint  { background-image: url('{{ "{{ASSET_BASE}}" }}/items/metal-shield.png'); }
.sheet-slot--equip_main_hand .sheet-slot-hint { background-image: url('{{ "{{ASSET_BASE}}" }}/items/one-handed-sword.png'); }
.sheet-slot--equip_torso .sheet-slot-hint     { background-image: url('{{ "{{ASSET_BASE}}" }}/items/chestplate.png'); }
.sheet-slot--equip_belt .sheet-slot-hint      { background-image: url('{{ "{{ASSET_BASE}}" }}/items/legging-plate.png'); }
{# Jewel slots get a plain CSS star instead of a background-image, dead
   centered on the slot's own box (not the 15%/70% inset above, which is
   sized for the item-icon-shaped hints, not a glyph). #}
.sheet-slot--equip_jewel_1 .sheet-slot-hint,
.sheet-slot--equip_jewel_2 .sheet-slot-hint {
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  line-height: 1;
  color: #2b1d0e;
}
.sheet-slot--equip_jewel_1 .sheet-slot-hint::before,
.sheet-slot--equip_jewel_2 .sheet-slot-hint::before {
  content: "★";
}

/* ---- Hand-state visuals (all selectors start at the .sheet-arx mirrors). ---- */

/* While holding an item: the "selected" cursor replaces every interactive
   surface's own cursor (slot buttons, hover zones, pouch/purse/trash/nav). */
input[name="attr_hand"]:not([value=""]) ~ .sheet-book .sheet-slot button,
input[name="attr_hand"]:not([value=""]) ~ .sheet-inventory .sheet-slot button,
input[name="attr_hand"]:not([value=""]) ~ .sheet-book .sheet-hover-zone,
input[name="attr_hand"]:not([value=""]) ~ .sheet-inventory .sheet-pouch,
input[name="attr_hand"]:not([value=""]) ~ .sheet-purse,
input[name="attr_hand"]:not([value=""]) ~ .sheet-inventory .sheet-trash,
input[name="attr_hand"]:not([value=""]) ~ .sheet-inventory .sheet-bag-nav {
  cursor: url('{{ "{{ASSET_BASE}}" }}/ui/cursor-hover.png') 8 4, grabbing;
}

/* Origin slot of the item in hand: dim its icon. */
{% set all_slots = [] %}
{% for i in range(1, total + 1) %}{% set _ = all_slots.append("bag_" ~ i) %}{% endfor %}
{% for s in ["equip_head", "equip_torso", "equip_belt", "equip_main_hand",
             "equip_off_hand", "equip_jewel_1", "equip_jewel_2"] %}{% set _ = all_slots.append(s) %}{% endfor %}
{% for slot in all_slots %}
input[name="attr_hand_from"][value="{{ slot }}"] ~ .sheet-book .sheet-slot--{{ slot }} .sheet-item-icon,
input[name="attr_hand_from"][value="{{ slot }}"] ~ .sheet-inventory .sheet-slot--{{ slot }} .sheet-item-icon {
  filter: brightness(0.5);
}
{% endfor %}

{# A "deux_mains" item picked up from either hand slot also dims its twin
   (see equip_main_hand/equip_off_hand's mirrored real item id in
   inventory.js) — the loop above only dims the exact slot in
   attr_hand_from, not the OTHER hand holding the same item. #}
.sheet-arx:has(input[name="attr_hand_from"][value="equip_main_hand"]):has(input[name="attr_hand_cat"][value="deux_mains"]) .sheet-slot--equip_off_hand .sheet-item-icon,
.sheet-arx:has(input[name="attr_hand_from"][value="equip_off_hand"]):has(input[name="attr_hand_cat"][value="deux_mains"]) .sheet-slot--equip_main_hand .sheet-item-icon {
  filter: brightness(0.5);
}

{# A "deux_mains" item, once equipped, occupies both hand slots with the
   same real item id — attr_two_handed_primary marks which slot was
   actually clicked (see inventory.js), so the OTHER one reads as a
   transparent "blocked" mirror instead of a second full-opacity icon. #}
.sheet-arx:has(input[name="attr_two_handed_primary"][value="equip_main_hand"]) .sheet-slot--equip_off_hand .sheet-item-icon {
  opacity: 0.35;
}
.sheet-arx:has(input[name="attr_two_handed_primary"][value="equip_off_hand"]) .sheet-slot--equip_main_hand .sheet-item-icon {
  opacity: 0.35;
}

/* Valid bag anchors while an item is in hand: the worker publishes them in attr_fit. */
{% for i in range(1, total + 1) %}
input[name="attr_fit"][value*="|bag_{{ i }}|"] ~ .sheet-inventory .sheet-slot--bag_{{ i }} button {
  background: radial-gradient(circle, rgba(255, 232, 160, 0.35), rgba(255, 232, 160, 0) 75%);
  box-shadow: 0 0 12px rgba(255, 220, 130, 0.7);
}
{% endfor %}

/* Equipment slots glow when the hand item's category matches AND the slot is empty (no swap). */
{% set equip_glow_pairs = [("casque", "equip_head"), ("armure_haute", "equip_torso"),
                     ("armure_basse", "equip_belt"), ("main_principale", "equip_main_hand"),
                     ("ambidextrie", "equip_main_hand"), ("ambidextrie", "equip_off_hand"),
                     ("main_secondaire", "equip_off_hand"),
                     ("deux_mains", "equip_main_hand"), ("deux_mains", "equip_off_hand"),
                     ("bijoux", "equip_jewel_1"), ("bijoux", "equip_jewel_2")] %}
{% for cat, slot in equip_glow_pairs %}
input[name="attr_hand_cat"][value="{{ cat }}"] ~ .sheet-book .sheet-slot--{{ slot }} input[value=""] ~ button {
  background: radial-gradient(circle, rgba(255, 232, 160, 0.45), rgba(255, 232, 160, 0) 75%);
  box-shadow: 0 0 14px rgba(255, 220, 130, 0.85);
}
{% endfor %}

/* Same slots, red instead of gold, when the held item has a min_<attr>
   requirement the character does not meet: the worker publishes
   attr_hand_too_heavy at pickup and the equip click is refused (see
   tooHeavy() in the worker — the name predates the other three attributes).
   Listed after the gold rules and more specific, so it overrides them. */
{% set red_glow %}
  background: radial-gradient(circle, rgba(255, 90, 70, 0.45), rgba(255, 90, 70, 0) 75%);
  box-shadow: 0 0 14px rgba(255, 60, 40, 0.85);
{% endset %}
{% for cat, slot in equip_glow_pairs %}
.sheet-arx:has(input[name="attr_hand_too_heavy"][value="1"]) input[name="attr_hand_cat"][value="{{ cat }}"] ~ .sheet-book .sheet-slot--{{ slot }} input[value=""] ~ button {
{{- red_glow -}}
}
{% endfor %}

/* Cursor: grab on a filled slot when nothing is in hand. */
/* Hovering a clickable item still in its original slot (not picked up yet). */
.sheet-slot input:not([value=""]) ~ button {
  cursor: url('{{ "{{ASSET_BASE}}" }}/ui/cursor-hover.png') 6 4, grab;
}
