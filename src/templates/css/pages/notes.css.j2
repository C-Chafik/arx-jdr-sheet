/* Handwritten look, deliberately distinct from the rest of the sheet's
   EB Garamond (see base.css) — this is the player's own free-form scrawl,
   not a printed stat block. */
@import url('https://fonts.googleapis.com/css2?family=Homemade+Apple&display=swap');

/* Free text, 5 independent pages (left+right per page) — all in the DOM,
   only the pair matching attr_notes_page shown (see clicked:notes_prev/next
   in inventory.js). First-pass rectangle over notes.png's writable area. */
.sheet-notes-field {
  position: absolute !important;
  /* Fixed px, not %: .sheet-book is a fixed 1100x677 box (see base.css) — no
     ambiguity about what the percentage would even be relative to.
     !important throughout: Roll20 injects its own default textarea/input
     styling that can silently win over custom width/height otherwise. */
  top: 68px !important;
  width: 433px !important;
  height: 530px !important;
  padding: 0 !important;
  border: none !important;
  background: transparent !important;
  resize: none !important;
  outline: none !important;
  /* No scrolling past the box — text just clips once it overflows, it
     doesn't scroll to reveal more. */
  overflow: hidden !important;
  font-family: 'Homemade Apple', cursive;
  font-size: 20px;
  line-height: 1.4;
  color: #2b1d0e;
  display: none;
}
.sheet-notes-field--left {
  left: 120px !important;
  /* Homemade Apple's cursive glyphs carry a decorative left-side flourish
     on some letters (capitals especially) that can render outside the box
     when they're the very first character on a line — a small left inset
     absorbs that without shifting where the box itself sits. Only needed
     here: the right field hasn't shown the same overhang. */
  padding-left: 8px !important;
}
.sheet-notes-field--right { left: 594px !important; }

{% for n in range(1, 6) %}
.sheet-arx:has(input[name="attr_notes_page"][value="{{ n }}"]) .sheet-notes-field--page-{{ n }} {
  display: block;
}
{% endfor %}

/* Page-turn nav is disabled for now (see tabs.css/inventory.js history) —
   attr_notes_page never leaves "1", so only page 1's fields ever show. The
   5-page rule above stays as-is, ready for whenever navigation comes back. */
