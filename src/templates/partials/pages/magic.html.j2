{# Magic page. Background swaps to ARX-MAGICBOOK.png (see tabs.css).
   Left side: the 10 numbered spell-page tabs baked into the artwork (left
   edge) are buttons + the sheet worker set attr_spell_page (radio/label with
   id/for is unreliable on Roll20 — multiple sheet copies can be in the DOM
   at once, ids collide) — it picks which 4 of the up-to-40 spells
   (spells.json, page × 4 slots) occupy the 4 fixed slot positions. A spell
   only shows once every rune it needs has been learned (see
   magic-slots.css.j2 for the page+rune AND-chain).
   Right side is fixed and never changes: 20 slots reveal a learned rune's
   magicbook icon, filled in order as the player consumes runes (pick one up,
   click the grimoire) — see src/workers/inventory.js and magic-slots.css.j2.
   Positions below are a first pass over the art's blank parchment areas —
   expect a visual tuning pass. #}
<div class="sheet-page sheet-page--magic">
  {# Spell-page navigation: one button per numbered tab (1-10); the worker
     sets attr_spell_page on click (see src/workers/inventory.js). #}
  <input type="hidden" name="attr_spell_page" value="1" />
  {# Which spell's rune recipe is currently highlighted in the 20-slot grid
     (see act_cast_* handlers in inventory.js) — empty when none. #}
  <input type="hidden" name="attr_recipe_spell" value="" />
{% for p in range(1, 11) %}
  <button type="action" class="sheet-spell-page-tab sheet-spell-page-tab--{{ p }}" name="act_goto_spellpage_{{ p }}"></button>
{% endfor %}
  {# The 4 fixed slot positions (2×2: 1=top-left, 2=top-right, 3=bottom-left,
     4=bottom-right); which spell (if any) shows in each depends on the active
     page and whether its runes are all known. A spell shows its own icon
     (spells.json "icon", scaled to fit its box, aspect preserved) once art
     exists — until then it falls back to its text label. #}
{% for spell_id, spell in spells.items() %}
  <button type="action" class="sheet-spell-slot sheet-spell-slot--slot-{{ spell.slot }} sheet-spell-slot--{{ spell_id }}" name="act_cast_{{ spell_id }}">{% if spell.icon %}<span class="sheet-spell-icon"></span>{% else %}{{ spell.label }}{% endif %}</button>
{% endfor %}
  {# Each learned-rune slot is also the rune-craft trigger: clicking it
     appends that rune (in order) to attr_craft_runes (see inventory.js).
     Clicking an empty slot is a no-op (worker checks the rune is set). #}
{% for i in range(1, 21) %}
  <button type="action" class="sheet-spellbook-slot sheet-spellbook-slot--{{ i }}" name="act_craft_rune_{{ i }}">
    <input type="hidden" name="attr_spellbook_{{ i }}" value="" />
    <span class="sheet-item-icon"></span>
    <span class="sheet-recipe-order"></span>
  </button>
{% endfor %}
  {# The grimoire: drop any consumed rune here to learn it permanently. #}
  <button type="action" class="sheet-grimoire" name="act_slot_grimoire"></button>
  {# Rune-craft: Validate checks the accumulated combination against
     presets.json and fills the first empty preset slot on an exact match;
     Reset clears the in-progress combination without validating. If Reset
     is clicked with no rune in the combo, it instead enters "forget a
     preset" mode (attr_forget_mode) — see the preset slots below and
     inventory.js's clicked:preset_N handler. #}
  <input type="hidden" name="attr_craft_runes" value="" />
  <input type="hidden" name="attr_forget_mode" value="0" />
  <button type="action" class="sheet-craft-reset" name="act_craft_reset"></button>
  {# Launch: consumes the crafted rune combination — will trigger the actual
     Roll20 dice roll once that mechanic is designed (see SPEC.md); for now
     it just clears the combo. #}
  <button type="action" class="sheet-craft-confirm" name="act_craft_confirm"></button>
  {# Memorize: matches the crafted rune combination against presets.json and
     fills the first empty preset slot on an exact match (works for both
     book spells and secret-only ones) — consumes the combo either way. #}
  <button type="action" class="sheet-craft-memorize" name="act_memorize"></button>
  <div class="sheet-statbar sheet-statbar--craft-reset">Supprimer le sort</div>
  <div class="sheet-statbar sheet-statbar--craft-confirm">Lancer le sort</div>
  <div class="sheet-statbar sheet-statbar--craft-memorize">Mémoriser le sort</div>
  {# Craft sequence: shows, in click order, the rune's own inventory icon
     (not the magicbook variant) so the player sees exactly what they've
     incanted so far before validating. Fixed 5 positions (CRAFT_MAX in
     inventory.js). #}
{% for i in range(1, 6) %}
  <div class="sheet-craft-seq sheet-craft-seq--{{ i }}">
    <input type="hidden" name="attr_craft_pos_{{ i }}" value="" />
    <span class="sheet-item-icon"></span>
  </div>
{% endfor %}
  {# 3 memorized-spell (preset) slots, lower-left of the left page. Each can
     hold any preset-eligible spell (book spell or secret one, see
     presets.json) — obtaining one (scroll item / action sequence) isn't
     wired yet, this only renders whatever attr_preset_slot_N holds. #}
{% for n in range(1, 4) %}
  <button type="action" class="sheet-preset-slot sheet-preset-slot--{{ n }}" name="act_preset_{{ n }}">
    <input type="hidden" name="attr_preset_slot_{{ n }}" value="" />
    <span class="sheet-preset-icon"></span>
  </button>
{% endfor %}
</div>
