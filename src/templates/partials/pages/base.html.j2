{% import "data/stats.j2" as stats %}
{% set attributes = ["strength", "mental", "dexterity", "constitution"] %}
{% set skills = ["stealth", "technical", "intuition",
                 "ethereal_link", "object_knowledge", "casting",
                 "close_combat", "projectile", "defense"] %}
{% set gauges = ["health", "mana"] %}
{% set singles = ["armor_class", "magic_resistance", "poison_resistance", "damages"] %}
{# Base stats before any modifier — see the user's own numbers, not a design guess. #}
{% set defaults = {
  "strength": 6, "mental": 6, "dexterity": 6, "constitution": 6,
  "stealth": 12, "technical": 12, "intuition": 12, "ethereal_link": 12,
  "object_knowledge": 15, "casting": 12,
  "close_combat": 18, "projectile": 18, "defense": 18,
  "armor_class": 1, "magic_resistance": 12, "poison_resistance": 16, "damages": 3,
  "health": 12, "mana": 6,
} %}
{# Seeds for attribute-derived "singles" (Arx Fatalis attribute tables —
   constitution/intelligence bonus columns), kept in a SEPARATE dict from
   skills' own seeds on purpose: this mechanic can be pulled out later
   without touching the skill formulas at all. Computed at strength/mental/
   dexterity/constitution=6 (this sheet's own defaults) — see
   recomputeSingleStatMods in inventory.js. (damages and the HP/mana max ×
   level mechanics were tried and removed — see git history.) #}
{% set single_stat_mod_seeds = {
  "damages": 0, "poison_resistance": 12, "magic_resistance": 12,
} %}
<div class="sheet-page sheet-page--base">
  {# character_name is Roll20-magic: it syncs with the journal name both ways. #}
  <div class="sheet-field sheet-field--character_name">
    <input type="text" name="attr_character_name" value="" />
  </div>
  <div class="sheet-field sheet-field--level">
    <input type="number" name="attr_level" value="0" />
  </div>
{% for name in attributes + skills + singles %}
  <div class="sheet-field sheet-field--{{ name }}">
    {# The one and only visible/editable value — manual edits (leveling,
       point-buy) are safe: equipment changes only ever apply the DELTA in
       gear bonus on top of whatever's here (see recomputeModifiers in
       inventory.js), never a full recompute from scratch. #}
    <input type="number" name="attr_{{ name }}" value="{{ defaults[name] }}" />
  </div>
  {# Remembers the equipment bonus last baked into attr_{{ name }}, so the
     next equipment change can apply just the difference. #}
  <input type="hidden" name="attr_{{ name }}_applied_mod" value="0" />
{% if name in skills %}
  {# Same delta technique, but for the attribute-derived portion (Arx
   Fatalis skill formulas — see recomputeStatMods in inventory.js). Starts
   at this skill's own default, since that default already IS the formula's
   result at strength/mental/dexterity/constitution = 6 with 0 raw points
   (wiki.arx-libertatis.org/Skills: "effective minimum of 12 to 18 due to
   skill bonuses received from starting 6 points in each attribute"). #}
  <input type="hidden" name="attr_{{ name }}_applied_stat_mod" value="{{ defaults[name] }}" />
{% endif %}
{% if name in single_stat_mod_seeds %}
  {# Attribute-derived portion of this single, tracked separately from
     skills (see recomputeSingleStatMods in inventory.js) — deliberately
     isolated so this whole mechanic can be removed on its own later. #}
  <input type="hidden" name="attr_{{ name }}_applied_stat_mod" value="{{ single_stat_mod_seeds[name] }}" />
{% endif %}
{% endfor %}
{% for name in gauges %}
  <div class="sheet-field sheet-gauge sheet-field--{{ name }}">
    <input type="number" name="attr_{{ name }}" value="{{ defaults[name] }}" />
    <span class="sheet-gauge-sep">/</span>
    <input type="number" name="attr_{{ name }}_max" value="{{ defaults[name] }}" />
  </div>
  {# Only the MAX side takes equipment modifiers (same delta technique as
     the other stats — see recomputeModifiers in inventory.js). No
     attribute/level-derived mechanic on health_max/mana_max — tried and
     removed, see git history. #}
  <input type="hidden" name="attr_{{ name }}_max_applied_mod" value="0" />
{% endfor %}
  {# Roll buttons: skills roll 1d100 (roll-under against their own live
     value, shown alongside for comparison — see "On tente l'incantation"
     decisions). Attributes/armor_class/magic_resistance/poison_resistance
     stay inert for now ("on touche pas" — not yet designed). Damages is a
     type="action" button instead (see below): it needs to look up the
     equipped weapon's own label, which a static roll value can't do. #}
{% for name, label, text in stats.stat_infos %}
{% if name in stats.no_roll %}
  <div class="sheet-hover-zone sheet-hover--{{ name }}"></div>
{% elif name == "damages" %}
  <button type="action" class="sheet-hover-zone sheet-hover--{{ name }}" name="act_roll_damages"></button>
{% elif name in skills %}
{% set roll_value = "&{template:default} {{" ~ "name=" ~ label ~ "}} {{" ~ "Valeur=@{" ~ name ~ "}}} {{" ~ "Jet=[[1d100]]}}" %}
  <button type="roll" class="sheet-hover-zone sheet-hover--{{ name }}" name="roll_{{ name }}" value="{{ roll_value }}"></button>
{% else %}
  <button type="roll" class="sheet-hover-zone sheet-hover--{{ name }}" name="roll_{{ name }}" value=""></button>
{% endif %}
  <div class="sheet-statbar sheet-statbar--{{ name }}">{{ label }} &mdash; {{ text }}</div>
{% endfor %}
  {# Equipment slots on the left page (categories enforced by the worker). #}
{% set equip_labels = {
  "equip_head": "Casque",
  "equip_torso": "Plastron",
  "equip_belt": "Jambières",
  "equip_main_hand": "Arme principale",
  "equip_off_hand": "Arme secondaire",
  "equip_jewel_1": "Emplacement bijoux",
  "equip_jewel_2": "Emplacement bijoux",
} %}
{% for slot in ["equip_head", "equip_torso", "equip_belt", "equip_main_hand",
                "equip_off_hand", "equip_jewel_1", "equip_jewel_2"] %}
  <div class="sheet-slot sheet-slot--{{ slot }}">
    <input type="hidden" name="attr_{{ slot }}" value="" />
    <span class="sheet-item-icon"></span>
    {# Faint background hint of what goes here — hidden once an item is
       equipped. Placed after .sheet-item-icon so its own "+" adjacent-sibling
       reveal rule (input[value=X] + .sheet-item-icon) still matches. #}
    <span class="sheet-slot-hint"></span>
    <button type="action" name="act_slot_{{ slot }}"></button>
  </div>
  <div class="sheet-statbar sheet-statbar--{{ slot }}">{{ equip_labels[slot] }}</div>
{% endfor %}
</div>
