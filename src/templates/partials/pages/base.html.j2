{% import "data/stats.j2" as stats %}
{% set attributes = ["strength", "mental", "dexterity", "constitution"] %}
{% set skills = ["stealth", "technical", "intuition",
                 "ethereal_link", "object_knowledge", "casting",
                 "close_combat", "projectile", "defense"] %}
{% set gauges = ["health", "mana"] %}
{% set singles = ["armor_class", "magic_resistance", "poison_resistance", "damages"] %}
{# Posture Focus adds the skill's own governing attribute to the roll
   target (see the Postures conversation). Single-attribute skills are
   unambiguous; the 3 mixed-formula ones use their dominant coefficient
   (Technique has no dominant term — Dextérité picked arbitrarily). #}
{% set skill_primary_attr = {
  "stealth": "dexterity", "technical": "dexterity", "intuition": "mental",
  "ethereal_link": "mental", "object_knowledge": "mental", "casting": "mental",
  "close_combat": "strength", "projectile": "dexterity", "defense": "constitution",
} %}
{# French display labels for skill_primary_attr, used in the Focus roll's
   "Valeur" line (see below) — same 4 attributes as stats.j2's own labels,
   duplicated here since stats.j2 keys by stat name, not by this dict's
   purpose. #}
{% set attr_labels = {
  "strength": "Force", "mental": "Mental", "dexterity": "Dextérité", "constitution": "Constitution",
} %}
{# Base stats before any modifier — see the user's own numbers, not a design guess. #}
{% set defaults = {
  "strength": 6, "mental": 6, "dexterity": 6, "constitution": 6,
  "stealth": 12, "technical": 12, "intuition": 12, "ethereal_link": 12,
  "object_knowledge": 15, "casting": 12,
  "close_combat": 18, "projectile": 18, "defense": 18,
  "armor_class": 1, "magic_resistance": 12, "poison_resistance": 16, "damages": 3,
  "health": 12, "mana": 6,
} %}
{# Seeds for attribute/skill-derived "singles" (wiki.arx-libertatis.org/Stats'
   "Other stats" formulas), kept in a SEPARATE dict from skills' own seeds on
   purpose: this mechanic can be pulled out later without touching the skill
   formulas at all. Computed at this sheet's own defaults (attributes=6,
   defense=18, casting=12, close_combat=18) — see recomputeSingleStatMods in
   inventory.js. (The HP/mana max × level mechanic was tried and removed
   once, then reintroduced properly — see git history.) #}
{% set single_stat_mod_seeds = {
  "damages": 3, "armor_class": 1, "magic_resistance": 12, "poison_resistance": 16,
} %}
<div class="sheet-page sheet-page--base">
  {# character_name is Roll20-magic: it syncs with the journal name both ways. #}
  <div class="sheet-field sheet-field--character_name">
    <input type="text" name="attr_character_name" value="" />
  </div>
  {# Worker-maintained length bucket (see change:character_name in
     inventory.js) — drives the auto-shrink font-size rules in
     base.css.j2 so long names still fit the fixed-width field. #}
  <input type="hidden" name="attr_character_name_size" value="normal" />
  <div class="sheet-field sheet-field--level">
    <input type="number" name="attr_level" value="0" />
  </div>
  {# Caster level: hidden, never shown to the player (wiki.arx-libertatis.org/
     Caster_level — "(full_casting + full_mind) / 10", clamped 1-10). Not
     player-facing yet, but needed for spell power/duration/mana cost and
     scroll potency later — see recomputeCasterLevel in inventory.js. #}
  <input type="hidden" name="attr_caster_level" value="1" />
  {# Postures: one active at a time (attr_posture), clicking the active one
     again clears it — same toggle pattern as clicked:cast_<spellId> (see
     inventory.js). Guardian stays hidden until the GM unlocks it via the
     !arxunlockguardian API command (attr_posture_guardian_unlocked) — a GM
     call, not tied to level. #}
  <input type="hidden" class="sheet-hand-mirror" name="attr_posture" value="" />
  <input type="hidden" class="sheet-hand-mirror" name="attr_posture_guardian_unlocked" value="" />
  {# 0/1 flag, worker-maintained (see recomputeFocusActive in inventory.js)
     — multiplied into the skill roll formulas above so the Focus bonus
     only applies live, without converting those buttons to type="action". #}
  <input type="hidden" class="sheet-hand-mirror" name="attr_focus_active" value="0" />
{% for name in ["defensive", "offensive", "focus", "guardian"] %}
  <button type="action" class="sheet-posture-btn sheet-posture-btn--{{ name }}" name="act_posture_{{ name }}"></button>
{% endfor %}
  {# Fate status (Faveur du Noden / Coups du sort): GM-set only, via the
     !arxfavor/!arxtwist/!arxfateclear API commands (see arx-mod.js) — the
     sheet never writes it, so the icons are plain divs, not buttons. One
     status at a time, same exclusivity as attr_posture. #}
  <input type="hidden" class="sheet-hand-mirror" name="attr_fate" value="" />
  <div class="sheet-fate-icon sheet-fate-icon--favor"></div>
  <div class="sheet-fate-icon sheet-fate-icon--twist"></div>
  {# Same per-character rainbow treatment as the "Pannel MJ" statbar. #}
  <div class="sheet-statbar sheet-statbar--fate-favor">{% for char in "Faveur du Noden" %}<span class="sheet-rainbow-{{ loop.index0 % 6 }}">{{ char }}</span>{% endfor %}</div>
  <div class="sheet-statbar sheet-statbar--fate-twist">Coups du sort</div>
  <div class="sheet-statbar sheet-statbar--posture-defensive">Posture Défensive — Parade et Esquive autorisé</div>
  <div class="sheet-statbar sheet-statbar--posture-offensive">Posture Offensive — Dégâts maximum, seuil critique doublé</div>
  <div class="sheet-statbar sheet-statbar--posture-focus">Focus — Bonus de stats sur les jets, réduction du coût en mana</div>
  <div class="sheet-statbar sheet-statbar--posture-guardian">Posture du Gardien - Effet inconnue</div>
{% set read_only_stats = ["damages", "armor_class", "magic_resistance", "poison_resistance"] %}
{% for name in attributes + skills + singles %}
  <div class="sheet-field sheet-field--{{ name }}">
{% if name in read_only_stats %}
    {# Not manually editable (only equipment/attribute mods touch it) — CA/
       CAM/CAP stay hover-only (no roll, see stats.j2's no_roll), damages is
       still rolled via act_roll_damages. A <span name="attr_X"> instead of
       a readonly <input>: Roll20 doesn't reliably refresh a readonly
       input's DISPLAYED value from setAttrs, spans do (see
       recomputeModifiers/recomputeSingleStatMods in inventory.js, and the
       notes-page saga earlier in this project). #}
    <span name="attr_{{ name }}">{{ defaults[name] }}</span>
{% else %}
    {# The one and only visible/editable value — manual edits (leveling,
       point-buy) are safe: equipment changes only ever apply the DELTA in
       gear bonus on top of whatever's here (see recomputeModifiers in
       inventory.js), never a full recompute from scratch. #}
    <input type="number" name="attr_{{ name }}" value="{{ defaults[name] }}" />
{% endif %}
  </div>
  {# Remembers the equipment bonus last baked into attr_{{ name }}, so the
     next equipment change can apply just the difference. #}
  <input type="hidden" name="attr_{{ name }}_applied_mod" value="0" />
{% if name in skills %}
  {# Same delta technique, but for the attribute-derived portion (Arx
   Fatalis skill formulas — see recomputeStatMods in inventory.js). Starts
   at this skill's own default, since that default already IS the formula's
   result at strength/mental/dexterity/constitution = 6 with 0 raw points
   (wiki.arx-libertatis.org/Skills: "effective minimum of 12 to 18 due to
   skill bonuses received from starting 6 points in each attribute"). #}
  <input type="hidden" name="attr_{{ name }}_applied_stat_mod" value="{{ defaults[name] }}" />
{% endif %}
{% if name in single_stat_mod_seeds %}
  {# Attribute-derived portion of this single, tracked separately from
     skills (see recomputeSingleStatMods in inventory.js) — deliberately
     isolated so this whole mechanic can be removed on its own later. #}
  <input type="hidden" name="attr_{{ name }}_applied_stat_mod" value="{{ single_stat_mod_seeds[name] }}" />
{% endif %}
{% endfor %}
{% for name in gauges %}
  <div class="sheet-field sheet-gauge sheet-field--{{ name }}">
    <input type="number" name="attr_{{ name }}" value="{{ defaults[name] }}" />
    <span class="sheet-gauge-sep">/</span>
    {# Max isn't manually editable, only equipment mods touch it — a
       <span name="attr_X"> instead of a readonly <input>, same reasoning
       as attr_damages above (readonly inputs don't reliably refresh from
       setAttrs on Roll20). #}
    <span class="sheet-gauge-max" name="attr_{{ name }}_max">{{ defaults[name] }}</span>
  </div>
  {# Only the MAX side takes equipment modifiers (same delta technique as
     the other stats — see recomputeModifiers in inventory.js). #}
  <input type="hidden" name="attr_{{ name }}_max_applied_mod" value="0" />
  {# Attribute+level-derived portion (wiki.arx-libertatis.org/Stats:
     constitution×(level+2) for health, mental×(level+1) for mana — see
     recomputeGaugeMax in inventory.js), tracked separately from the
     equipment mod above so the two never clobber each other. Starts at
     this gauge's own default, since that default already IS the formula's
     result at level 0 / constitution or mental = 6 (this sheet's starting
     values). #}
  <input type="hidden" name="attr_{{ name }}_max_applied_stat_mod" value="{{ defaults[name] }}" />
{% endfor %}
  {# Roll buttons: skills roll 1d100 (roll-under against their own live
     value, shown alongside for comparison — see "On tente l'incantation"
     decisions). Attributes/armor_class/magic_resistance/poison_resistance
     stay inert for now ("on touche pas" — not yet designed). Damages is
     inert too: the attack roll moved onto its own per-hand buttons below,
     so this one keeps its hover tooltip and nothing else. #}
{% for name, label, text in stats.stat_infos %}
{% if name in stats.no_roll or name == "damages" %}
  <div class="sheet-hover-zone sheet-hover--{{ name }}"></div>
{% elif name in skills %}
  {# Two roll buttons, swapped via CSS on attr_posture=focus (see
     base.css.j2) — same spot, only one ever visible/clickable at a time.
     Focus's bonus needs to read as "12 + Dextérité (Focus)" in the chat,
     not a raw "12+(6*1)" formula nor a hidden-behind-hover total, so it
     can't be a single formula-driven button: the attribute's own French
     label is static text, only the skill value itself is live. #}
{% set roll_value = "&{template:default} {{" ~ "name=" ~ label ~ "}} {{" ~ "Valeur=@{" ~ name ~ "}}} {{" ~ "Jet=[[1d100]]}}" %}
  <button type="roll" class="sheet-hover-zone sheet-hover--{{ name }} sheet-roll--no-focus" name="roll_{{ name }}" value="{{ roll_value }}"></button>
{% set roll_value_focus = "&{template:default} {{" ~ "name=" ~ label ~ "}} {{" ~ "Valeur=@{" ~ name ~ "} + " ~ attr_labels[skill_primary_attr[name]] ~ " (Focus) = [[@{" ~ name ~ "}+@{" ~ skill_primary_attr[name] ~ "}]]}} {{" ~ "Jet=[[1d100]]}}" %}
  <button type="roll" class="sheet-hover-zone sheet-hover--{{ name }} sheet-roll--focus" name="roll_{{ name }}_focus" value="{{ roll_value_focus }}"></button>
{% else %}
  <button type="roll" class="sheet-hover-zone sheet-hover--{{ name }}" name="roll_{{ name }}" value=""></button>
{% endif %}
  {# Where the number actually comes from, appended to the description in the
     very same billboard — same treatment as an item's spec line (see
     item_specs in sheet.html.j2), since it answers the same question about a
     different object. Live values: <span name="attr_X"> is refreshed by
     Roll20 itself, and attr_<name>_own is maintained by recomputeOwnShares
     in inventory.js.
     "base" is the share the player assigned by hand — the one the field
     never shows on its own, and the one a level-up lands in when the cap is
     already reached. Attributes have no attribute-derived share, so they
     read with two terms instead of three. #}
  <div class="sheet-statbar sheet-statbar--{{ name }}">{{ label }} &mdash; {{ text }}
{%- if name in attributes %}<span class="sheet-stat-breakdown"> - [base <span name="attr_{{ name }}_own">{{ defaults[name] }}</span> | équipement <span name="attr_{{ name }}_applied_mod">0</span>]</span>
{%- elif name in skills or name in singles %}<span class="sheet-stat-breakdown"> - [base <span name="attr_{{ name }}_own">0</span> | bonus <span name="attr_{{ name }}_applied_stat_mod">{{ defaults[name] }}</span> | équipement <span name="attr_{{ name }}_applied_mod">0</span>]</span>
{%- endif %}</div>
{% endfor %}
  {# Equipment slots on the left page (categories enforced by the worker). #}
{% set equip_labels = {
  "equip_head": "Casque",
  "equip_torso": "Plastron",
  "equip_belt": "Jambières",
  "equip_main_hand": "Main principale",
  "equip_off_hand": "Main secondaire",
  "equip_jewel_1": "Emplacement bijoux",
  "equip_jewel_2": "Emplacement bijoux",
} %}
{# A "deux_mains" item occupies both hand slots at once, holding the same
   real item id in each (see the equip-target branch of clicked:slot_<slot>
   in inventory.js) — this marks which of the two was actually clicked, so
   the other one can be dimmed (see inventory-slots.css.j2). Empty when no
   two-handed item is equipped. #}
<input type="hidden" class="sheet-hand-mirror" name="attr_two_handed_primary" value="" />
{% for slot in ["equip_head", "equip_torso", "equip_belt", "equip_main_hand",
                "equip_off_hand", "equip_jewel_1", "equip_jewel_2"] %}
  <div class="sheet-slot sheet-slot--{{ slot }}">
    <input type="hidden" name="attr_{{ slot }}" value="" />
    <span class="sheet-item-icon"></span>
    {# Faint background hint of what goes here — hidden once an item is
       equipped. Placed after .sheet-item-icon so its own "+" adjacent-sibling
       reveal rule (input[value=X] + .sheet-item-icon) still matches. #}
    <span class="sheet-slot-hint"></span>
    <button type="action" name="act_slot_{{ slot }}"></button>
  </div>
  <div class="sheet-statbar sheet-statbar--{{ slot }}">{{ equip_labels[slot] }}</div>
{% endfor %}
  {# Attack roll, one button per hand, sitting just under its own slot. The
     two hands are fully independent: each button only ever looks at its own
     equip_<hand> attribute (see rollHandDamage in inventory.js), so a
     two-handed weapon — which mirrors itself into both slots — is rollable
     from either one. Whatever sits in the slot is rolled, shield or torch
     included; only its own weap_dmg decides whether dice are added on top
     of the Dégâts base, and an empty hand rolls the base alone (bare fists).
     type="action" rather than type="roll": the roll is computed in the
     worker (Roll20 fires no clicked: event for a roll button), which also
     means Roll20 draws no d20 badge on it — hence a real background image
     rather than an invisible click zone. #}
{% for slot in ["equip_main_hand", "equip_off_hand"] %}
  <button type="action" class="sheet-attack-btn sheet-attack-btn--{{ slot }}" name="act_attack_{{ slot }}"></button>
  <div class="sheet-statbar sheet-statbar--attack-{{ slot }}">Attaque &mdash; {{ equip_labels[slot] }}</div>
{% endfor %}
</div>
