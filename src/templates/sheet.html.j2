<div class="sheet-arx">
  {# Hand state mirrors: MUST stay before .sheet-book and .sheet-inventory so
     sibling CSS (~) can reach the slots in both containers. #}
  <input type="hidden" class="sheet-hand-mirror" name="attr_hand" value="" />
  <input type="hidden" class="sheet-hand-mirror" name="attr_hand_from" value="" />
  <input type="hidden" class="sheet-hand-mirror" name="attr_hand_cat" value="" />
  <input type="hidden" class="sheet-hand-mirror" name="attr_hand_effect" value="" />
  <input type="hidden" class="sheet-hand-mirror" name="attr_fit" value="" />
  {# Bag levels: count = unlocked, level = currently displayed. DOM order matters:
     bag_count BEFORE bag_level (nav visibility selectors chain them with ~). #}
  <input type="hidden" class="sheet-hand-mirror" name="attr_bag_count" value="1" />
  <input type="hidden" class="sheet-hand-mirror" name="attr_bag_level" value="1" />
  {# Known-rune flags: one per rune (attr_known_<suffix>, suffix = id minus
     "rune-"), set permanently once learned via the grimoire. Spell visibility
     (magic-slots.css.j2) reaches these through :has(), so position doesn't
     matter the way it does for the sibling-selector mirrors above. #}
{% for item_id, item in items.items() %}
{% if item.effect | default("") == "rune" %}
  <input type="hidden" class="sheet-hand-mirror" name="attr_known_{{ item_id[5:] }}" value="" />
{% endif %}
{% endfor %}
  {# Inventory toggle: always visible, whatever the active page. State saved per character. #}
  {# Inventory toggle: attr_inventory_open is set by the sheet worker on
     button click (see src/workers/inventory.js), not by a checkbox's
     :checked state — a checkbox styled with appearance:none doesn't
     reliably hide its native rendering cross-browser, and Roll20
     discourages label[for]/input[id] pairing anyway. Buttons + worker is
     the same mechanism already used for every other interactive element
     on the sheet. #}
  <input type="hidden" class="sheet-hand-mirror" name="attr_inventory_open" value="0" />
  <button type="action" class="sheet-inventory-toggle" name="act_inventory_toggle"></button>
  {# The money purse: top-level control next to the inventory toggle (not
     inside the band), same size, sitting just above it — see inventory.css.
     Drop a currency item here to add its value to attr_gold. #}
  <button type="action" class="sheet-purse" name="act_slot_purse"></button>
  {# Live gold count, shown just above the purse on hover only. #}
  <div class="sheet-gold-readout"><input type="number" class="sheet-gold-display" name="attr_gold" value="0" /></div>
  {# GM admin panel: full catalog, one "give" button per item — gated behind
     attr_gm_panel_unlocked, settable only via the !arxunlockpanel API
     command (see arx-mod.js), never by the sheet itself. Meant for the GM's
     own utility character, not a player's. The gear icon (and everything
     behind it) stays display:none unless unlocked — see gm-panel.css.j2. #}
  <input type="hidden" class="sheet-hand-mirror" name="attr_gm_panel_unlocked" value="" />
  <input type="hidden" class="sheet-hand-mirror" name="attr_gm_panel_open" value="0" />
  <input type="hidden" class="sheet-hand-mirror" name="attr_gm_panel_page" value="1" />
  <button type="action" class="sheet-gm-panel-toggle" name="act_gm_panel_toggle"></button>
  <div class="sheet-statbar sheet-statbar--gm-panel-toggle">Panel MJ</div>
  <div class="sheet-gm-panel">
{% include "partials/gm-panel.html.j2" %}
    <button type="action" class="sheet-gm-panel-nav sheet-gm-panel-nav--up" name="act_gm_panel_page_up"></button>
    <button type="action" class="sheet-gm-panel-nav sheet-gm-panel-nav--down" name="act_gm_panel_page_down"></button>
  </div>
  <div class="sheet-book">
{% include "partials/tabs.html.j2" %}
{% include "partials/pages/base.html.j2" %}
{% include "partials/pages/magic.html.j2" %}
{% include "partials/pages/notes.html.j2" %}
{% include "partials/pages/map.html.j2" %}
  {# Item names on hover — same billboard as the stat descriptions.
     Revealed by generated :has() rules in css/inventory-slots.css.j2.
     Legendary items get a star marker ahead of their name. #}
{% for item_id, item in items.items() %}
{% set spell_id = item_id[7:] if item_id.startswith("scroll-") else "" %}
{% set is_secret_preset_scroll = item.effect | default("") == "scroll" and spell_id in presets and presets[spell_id].secret %}
{% set is_custom_scroll = item.effect | default("") == "scroll" and spell_id != "" and spell_id not in spells and spell_id not in presets %}
{% set is_high_casting_scroll = is_custom_scroll and (item.spell_casting | default(0)) >= 85 %}
{% if is_secret_preset_scroll or is_high_casting_scroll %}
    {# Secret-spell scrolls (linked to a secret preset) and fully custom
       scrolls with spell_casting >= 85 have no class/level color (see
       magic-slots.css.j2) — same per-character rainbow identity as secret
       presets instead of a flat color, not a font. #}
    <div class="sheet-statbar sheet-statbar--item-{{ item_id }}">{% for char in item.label %}<span class="sheet-rainbow-{{ loop.index0 % 6 }}">{{ char }}</span>{% endfor %}</div>
{% else %}
    <div class="sheet-statbar sheet-statbar--item-{{ item_id }}">{% if item.legendary | default(false) %}★ {% endif %}{{ item.label }}</div>
{% endif %}
{% endfor %}
  {# Learned-rune names on hover (magic page only) — yellow with a star,
     revealed by :has() rules in css/magic-slots.css.j2. #}
{% for item_id, item in items.items() %}
{% if item.effect | default("") == "rune" %}
    <div class="sheet-statbar sheet-spell-statbar sheet-statbar--spell-{{ item_id }}">{{ item.label }}</div>
{% endif %}
{% endfor %}
  {# Known-spell names on hover (2x2 cast slots) — same yellow billboard as
     learned runes but no star (only runes and secret presets get one),
     revealed by :has() rules in css/magic-slots.css.j2. #}
{% for spell_id, spell in spells.items() %}
    <div class="sheet-statbar sheet-spell-statbar sheet-statbar--cast-{{ spell_id }}">{{ spell.label }}</div>
{% endfor %}
  {# Memorized-spell (preset) names on hover — same yellow as the book's
     spells, no star; a secret spell (no book entry) reads red WITH a star
     instead, revealed by :has() rules in css/magic-slots.css.j2.
     presets.json is self-contained (label + runes + icon), even for
     book-linked spells — so it doubles as the catalog used later to detect
     rune combinations. #}
{% for preset_id, preset in presets.items() %}
    <div class="sheet-statbar sheet-preset-statbar{% if preset.secret %} sheet-preset-statbar--secret{% endif %} sheet-statbar--preset-{{ preset_id }}">{% if preset.secret %}{% for char in preset.label %}<span class="sheet-rainbow-{{ loop.index0 % 6 }}">{{ char }}</span>{% endfor %}{% else %}{{ preset.label }}{% endif %}</div>
{% endfor %}
  </div>
  {# The leather band slides out from under the book when the toggle is checked. #}
  <div class="sheet-inventory">
{% include "partials/inventory-slots.html.j2" %}
  </div>
</div>
