<div class="sheet-arx">
  {# Hand state mirrors: MUST stay before .sheet-book and .sheet-inventory so
     sibling CSS (~) can reach the slots in both containers. #}
  <input type="hidden" class="sheet-hand-mirror" name="attr_hand" value="" />
  <input type="hidden" class="sheet-hand-mirror" name="attr_hand_from" value="" />
  <input type="hidden" class="sheet-hand-mirror" name="attr_hand_cat" value="" />
  <input type="hidden" class="sheet-hand-mirror" name="attr_hand_effect" value="" />
  {# "1" while the held item's min_strength exceeds attr_strength — turns the
     equip-slot glow red (see inventory-slots.css.j2). #}
  <input type="hidden" class="sheet-hand-mirror" name="attr_hand_too_heavy" value="" />
  <input type="hidden" class="sheet-hand-mirror" name="attr_fit" value="" />
  {# Bag levels: count = unlocked, level = currently displayed. DOM order matters:
     bag_count BEFORE bag_level (nav visibility selectors chain them with ~). #}
  <input type="hidden" class="sheet-hand-mirror" name="attr_bag_count" value="1" />
  <input type="hidden" class="sheet-hand-mirror" name="attr_bag_level" value="1" />
  {# Known-rune flags: one per rune (attr_known_<suffix>, suffix = id minus
     "rune-"), set permanently once learned via the grimoire. Spell visibility
     (magic-slots.css.j2) reaches these through :has(), so position doesn't
     matter the way it does for the sibling-selector mirrors above. #}
{% for item_id, item in items.items() %}
{% if item.effect | default("") == "rune" %}
  <input type="hidden" class="sheet-hand-mirror" name="attr_known_{{ item_id[5:] }}" value="" />
{% endif %}
{% endfor %}
  {# Inventory toggle: always visible, whatever the active page. State saved per character. #}
  {# Inventory toggle: attr_inventory_open is set by the sheet worker on
     button click (see src/workers/inventory.js), not by a checkbox's
     :checked state — a checkbox styled with appearance:none doesn't
     reliably hide its native rendering cross-browser, and Roll20
     discourages label[for]/input[id] pairing anyway. Buttons + worker is
     the same mechanism already used for every other interactive element
     on the sheet. #}
  <input type="hidden" class="sheet-hand-mirror" name="attr_inventory_open" value="0" />
  <button type="action" class="sheet-inventory-toggle" name="act_inventory_toggle"></button>
  {# The money purse: top-level control next to the inventory toggle (not
     inside the band), same size, sitting just above it — see inventory.css.
     Drop a currency item here to add its value to attr_gold. #}
  <button type="action" class="sheet-purse" name="act_slot_purse"></button>
  {# Live gold count, shown just above the purse on hover only. #}
  <div class="sheet-gold-readout"><input type="number" class="sheet-gold-display" name="attr_gold" value="0" /></div>
  {# GM admin panel: full catalog, one "give" button per item — gated behind
     attr_gm_panel_unlocked, settable only via the !arxunlockpanel API
     command (see arx-mod.js), never by the sheet itself. Meant for the GM's
     own utility character, not a player's. The gear icon (and everything
     behind it) stays display:none unless unlocked — see gm-panel.css.j2. #}
  <input type="hidden" class="sheet-hand-mirror" name="attr_gm_panel_unlocked" value="" />
  <input type="hidden" class="sheet-hand-mirror" name="attr_gm_panel_open" value="0" />
  <input type="hidden" class="sheet-hand-mirror" name="attr_gm_panel_page" value="1" />
  {# Set by the worker on search (see clicked:/change:gm_panel_search in
     inventory.js): every matching item id, delimited "|id|id|" like
     fitMask/craft_runes — glows each match, dims everything else (see
     gm-panel.css.j2). Empty means no active search, nothing dimmed. #}
  <input type="hidden" class="sheet-hand-mirror" name="attr_gm_panel_filter" value="" />
  {# Mirrored by arx-mod.js onto every admin character (gm_panel_unlocked=1)
     whenever a loot pool opens/closes (see !arxlootopen/!arxlootclose) —
     drives which of the two buttons per catalog slot is live: give
     directly, or add to the open pool (see gm-panel.html.j2/.css.j2). #}
  <input type="hidden" class="sheet-hand-mirror" name="attr_gm_panel_loot_open" value="0" />
  <button type="action" class="sheet-gm-panel-toggle" name="act_gm_panel_toggle"></button>
  {# "Pannel MJ" in the same per-character rainbow treatment as secret spells —
     purely decorative, no mechanical meaning here. #}
  <div class="sheet-statbar sheet-statbar--gm-panel-toggle">{% for char in "Pannel MJ" %}<span class="sheet-rainbow-{{ loop.index0 % 6 }}">{{ char }}</span>{% endfor %}</div>
  <div class="sheet-gm-panel">
{% include "partials/gm-panel.html.j2" %}
    <button type="action" class="sheet-gm-panel-nav sheet-gm-panel-nav--up" name="act_gm_panel_page_up"></button>
    <button type="action" class="sheet-gm-panel-nav sheet-gm-panel-nav--down" name="act_gm_panel_page_down"></button>
  </div>
  {# Search: outside/below the panel (not nested in it — that box clips
     anything past its own edges for the slide animation), so it never
     overlaps the nav arrows. Jumps to the page of (and highlights) the
     first item whose id/label contains this text — see
     clicked:gm_panel_search in inventory.js. Not a live filter (sheet
     workers can't toggle arbitrary element display outside CSS :has()
     rules), a "find it" jump instead. #}
  <input type="text" class="sheet-gm-panel-search" name="attr_gm_panel_search" placeholder="Rechercher..." />
  <button type="action" class="sheet-gm-panel-search-btn" name="act_gm_panel_search"></button>
  {# Loot strip: the last free space under the search bar, and outside the
     panel for the same clipping reason. One button per skin while no pool is
     open, a single "close" button while one is — swapped on the very same
     attr_gm_panel_loot_open the catalog slots already use, so opening a pool
     over an existing one is impossible from here. Literal type="roll" values,
     exactly like the give/add buttons: Roll20 sends them to chat as typed and
     arx-mod.js handles them unchanged (including its "select a token first"
     whisper). The visual lives on a <span> rather than on the button itself —
     button[type="roll"] carries a global background-image:none that kills
     Roll20's d20 badge (see base.css). #}
{% import "data/loot.j2" as loot %}
{% for skin, label in loot.loot_skins %}
  <div class="sheet-gm-loot-btn sheet-gm-loot-btn--skin sheet-gm-loot-btn--{{ skin }}">
    <span class="sheet-gm-loot-face">{{ label }}</span>
    <button type="roll" name="act_gm_loot_open_{{ skin | replace('-', '_') }}" value="!arxlootopen {{ skin }}"></button>
  </div>
{% endfor %}
  <div class="sheet-gm-loot-btn sheet-gm-loot-btn--close">
    <span class="sheet-gm-loot-face">Fermer le butin</span>
    <button type="roll" name="act_gm_loot_close" value="!arxlootclose"></button>
  </div>
{% include "partials/loot-panel.html.j2" %}
  <div class="sheet-book">
{% include "partials/tabs.html.j2" %}
{% include "partials/pages/base.html.j2" %}
{% include "partials/pages/magic.html.j2" %}
{% include "partials/pages/notes.html.j2" %}
{% include "partials/pages/map.html.j2" %}
  {# Item names on hover — same billboard as the stat descriptions.
     Revealed by generated :has() rules in css/inventory-slots.css.j2.
     Legendary items get a star marker ahead of their name.

     Equipment gets a spec line after its label, sections separated by " | "
     inside one bracket, EMPTY SECTIONS DROPPED ENTIRELY (never an empty
     "| |"):
       weapon   Label - [dice | bonuses | special | (requirements) | hand]
       armour   Label - [CA - CAM - CAP | bonuses | special | (requirements)]
       jewel    Label - [bonuses | special | (requirements)]
     The CATEGORY decides only whether the defensive block is pulled out
     front; the dice come from weap_dmg alone, whatever the item is. So the
     two halves stack rather than exclude each other, and a shield that also
     hits reads "[1d4 | 3 CA | ADD]" — its dice really are rolled (see
     rollHandDamage in inventory.js, which reads whatever the hand holds).
     A jewel has neither block nor dice: it only ever grants stats, so
     CA/CAM/CAP stay in the bonus list with everything else.
     Anything with no section at all (a plain "objet") keeps a bare label.

     ABBR is also the display ORDER of the bonus list (Jinja keeps insertion
     order), and doubles as the whitelist of stat keys worth printing. #}
{% import "data/stats.j2" as stats %}
{% set abbr = {"strength": "FOR", "mental": "MEN", "dexterity": "DEX", "constitution": "CON",
               "stealth": "DIS", "technical": "TEC", "intuition": "INT", "ethereal_link": "PSY",
               "object_knowledge": "MAN", "casting": "INC", "close_combat": "CMB",
               "projectile": "DST", "defense": "DEF",
               "armor_class": "CA", "magic_resistance": "CAM", "poison_resistance": "CAP",
               "damages": "DMG", "health_max": "PV", "mana_max": "PM"} %}
{% set defence_stats = ["armor_class", "magic_resistance", "poison_resistance"] %}
{% set hand_code = {"main_principale": "1H", "main_secondaire": "ADD",
                    "deux_mains": "2H", "ambidextrie": "AMB"} %}
{#- Only these lead with a defensive block; a jewel's CA/CAM/CAP is a bonus
    like any other, and a weapon's too. -#}
{% set armour_cats = ["casque", "armure_haute", "armure_basse", "main_secondaire"] %}
{% macro item_specs(item) %}
{%- set has_defence_block = item.cat in armour_cats -%}
{%- set sections = [] -%}
{#- 1. what the item does. The two halves STACK, they do not exclude each
       other: weap_dmg alone decides the dice — no category gate, matching
       rollHandDamage, which rolls whatever a hand holds — and the defensive
       block is pulled out front for armour. A shield carrying dice gets
       both; a jewel gets neither. -#}
{%- if item.weap_dmg is defined %}{% set _ = sections.append(item.weap_dmg) %}{% endif -%}
{%- if has_defence_block -%}
{%- set defence = [] -%}
{%- for name in defence_stats if item[name] is defined -%}
{%- set _ = defence.append(item[name] ~ " " ~ abbr[name]) -%}
{%- endfor -%}
{%- if defence %}{% set _ = sections.append(defence | join(" - ")) %}{% endif -%}
{%- endif -%}
{#- 2. bonuses and maluses: every other stat it carries, always signed -#}
{%- set mods = [] -%}
{%- for name, code in abbr.items() if item[name] is defined and not (has_defence_block and name in defence_stats) -%}
{%- set _ = mods.append(("+" if item[name] > 0 else "") ~ item[name] ~ " " ~ code) -%}
{%- endfor -%}
{%- if mods %}{% set _ = sections.append(mods | join("; ")) %}{% endif -%}
{#- 3. free prose. Its own key rather than a second meaning for "effect",
       which is a typed behaviour (scroll/rune/currency/food…) wired to code:
       one word in the wrong column there would silently make a sword edible
       or a pie inert. -#}
{%- if item.special is defined %}{% set _ = sections.append(item.special) %}{% endif -%}
{#- 4. what it takes to wear it (min_<attr>, enforced by tooHeavy in the worker) -#}
{%- set reqs = [] -%}
{%- for name, code in abbr.items() if item["min_" ~ name] is defined -%}
{%- set _ = reqs.append(item["min_" ~ name] ~ " " ~ code) -%}
{%- endfor -%}
{%- if reqs %}{% set _ = sections.append("(" ~ reqs | join("; ") ~ ")") %}{% endif -%}
{#- 5. which hand it takes up. -#}
{%- if item.cat in hand_code %}{% set _ = sections.append(hand_code[item.cat]) %}{% endif -%}
{%- if sections %}<span class="sheet-item-specs"> - [{{ sections | join(" | ") }}]</span>{% endif -%}
{% endmacro %}
{% for item_id, item in items.items() %}
{% set spell_id = item_id[7:] if item_id.startswith("scroll-") else "" %}
{% set is_secret_preset_scroll = item.effect | default("") == "scroll" and spell_id in presets and presets[spell_id].secret %}
{% set is_custom_scroll = item.effect | default("") == "scroll" and spell_id != "" and spell_id not in spells and spell_id not in presets %}
{% set is_high_casting_scroll = is_custom_scroll and (item.spell_casting | default(0)) >= 85 %}
{% if is_secret_preset_scroll or is_high_casting_scroll %}
    {# Secret-spell scrolls (linked to a secret preset) and fully custom
       scrolls with spell_casting >= 85 have no class/level color (see
       magic-slots.css.j2) — same per-character rainbow identity as secret
       presets instead of a flat color, not a font. #}
    <div class="sheet-statbar sheet-statbar--item-{{ item_id }}">{% for char in item.label %}<span class="sheet-rainbow-{{ loop.index0 % 6 }}">{{ char }}</span>{% endfor %}{{ item_specs(item) }}</div>
{% else %}
    <div class="sheet-statbar sheet-statbar--item-{{ item_id }}">{% if item.legendary | default(false) %}★ {% endif %}{{ item.label }}{{ item_specs(item) }}</div>
{% endif %}
{% endfor %}
  {# Learned-rune names on hover (magic page only) — yellow with a star,
     revealed by :has() rules in css/magic-slots.css.j2. #}
{% for item_id, item in items.items() %}
{% if item.effect | default("") == "rune" %}
    <div class="sheet-statbar sheet-spell-statbar sheet-statbar--spell-{{ item_id }}">{{ item.label }}</div>
{% endif %}
{% endfor %}
  {# Known-spell names on hover (2x2 cast slots) — same yellow billboard as
     learned runes but no star (only runes and secret presets get one),
     revealed by :has() rules in css/magic-slots.css.j2. #}
{% for spell_id, spell in spells.items() %}
    <div class="sheet-statbar sheet-spell-statbar sheet-statbar--cast-{{ spell_id }}">{{ spell.label }}</div>
{% endfor %}
  {# Memorized-spell (preset) names on hover — same yellow as the book's
     spells, no star; a secret spell (no book entry) reads red WITH a star
     instead, revealed by :has() rules in css/magic-slots.css.j2.
     presets.json is self-contained (label + runes + icon), even for
     book-linked spells — so it doubles as the catalog used later to detect
     rune combinations. #}
{% for preset_id, preset in presets.items() %}
    <div class="sheet-statbar sheet-preset-statbar{% if preset.secret %} sheet-preset-statbar--secret{% endif %} sheet-statbar--preset-{{ preset_id }}">{% if preset.secret %}{% for char in preset.label %}<span class="sheet-rainbow-{{ loop.index0 % 6 }}">{{ char }}</span>{% endfor %}{% else %}{{ preset.label }}{% endif %}</div>
{% endfor %}
  </div>
  {# The leather band slides out from under the book when the toggle is checked. #}
  <div class="sheet-inventory">
{% include "partials/inventory-slots.html.j2" %}
  </div>
</div>
